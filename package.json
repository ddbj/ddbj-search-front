{
  "name": "ddbj-search-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hook:check": "mise x -- hk check",
    "hook:fix": "mise x -- hk fix",
    "hook:install": "mise x -- hk install --mise",
    "dev": "vite",
    "dev:msw": "VITE_MSW=true vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:watch": "vitest --project=storybook",
    "test:all": "vitest run",
    "test:all:watch": "vitest",
    "lint": "oxlint -c oxlint.config.ts . --quiet",
    "lint:debug": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts . --fix --quiet",
    "format": "oxfmt -c oxfmt.config.ts .",
    "format:check": "oxfmt -c oxfmt.config.ts --check .",
    "type-check": "tsc -b --noEmit --pretty",
    "check-all": "pnpm run format && pnpm run lint && pnpm run type-check && pnpm run test",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score --file-scores"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "3.2.7",
    "@internationalized/date": "3.12.4",
    "@scalar/api-reference-react": "^0.9.85",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/zod-adapter": "^1.167.0",
    "@types/node": "^26.6.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@ver0/deep-equal": "^2.0.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "is-what": "^5.5.7",
    "jotai": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^16.1.2",
    "tailwindcss": "^4.3.3",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "^1.168.48",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "^10.6.5",
    "fallow": "^3.37.0",
    "msw": "^3.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
